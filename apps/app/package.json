{
  "name": "app",
  "version": "0.0.0",
  "private": true,
  "description": "jsonresume.org: React + Vite on @jsonresume/ui, served by a small Hono server",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --outDir dist/client && vite build --ssr src/entry-server.tsx --outDir dist/ssr && node scripts/prerender.ts",
    "start": "node server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src server scripts --ext .ts,.tsx"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@jsonresume/theme-metadata": "workspace:*",
    "@jsonresume/ui": "workspace:*",
    "hono": "^4.13.13",
    "pino": "^10.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@repo/eslint-config-custom": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.19.24",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vanilla-extract/css": "^1.21.3",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^27.0.0",
    "tsconfig": "workspace:*",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  }
}
