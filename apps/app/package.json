{
  "name": "app",
  "version": "0.0.0",
  "private": true,
  "description": "jsonresume.org: React + Vite on @jsonresume/ui, served by a small Hono server",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "vite build --outDir dist/client && vite build --ssr src/entry-server.tsx --outDir dist/ssr && vite build --ssr server/index.ts --outDir dist/server && vite build --ssr server/jobs.ts --outDir dist/jobs && node scripts/prerender.ts",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src server scripts --ext .ts,.tsx",
    "jobs": "node dist/jobs/jobs.js"
  },
  "dependencies": {
    "@effect/atom-react": "4.0.6",
    "@effect/platform-node": "4.0.6",
    "@fontsource-variable/open-sans": "^5.2.7",
    "@fontsource/ubuntu": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@jsonresume/ui": "workspace:*",
    "@repo/accounts": "workspace:^",
    "@repo/analytics": "workspace:^",
    "@repo/api": "workspace:*",
    "@repo/api-client": "workspace:^",
    "@repo/api-server": "workspace:^",
    "@repo/auth-pages": "workspace:^",
    "@repo/content": "workspace:*",
    "@repo/dashboard": "workspace:^",
    "@repo/database": "workspace:^",
    "@repo/domain": "workspace:*",
    "@repo/explore": "workspace:^",
    "@repo/images": "workspace:*",
    "@repo/job-board": "workspace:^",
    "@repo/jobs": "workspace:^",
    "@repo/mcp": "workspace:^",
    "@repo/pathways": "workspace:^",
    "@repo/profiles": "workspace:^",
    "@repo/resume-editor": "workspace:^",
    "@repo/resume-host": "workspace:^",
    "@repo/resume-pdf": "workspace:^",
    "@repo/resume-themes": "workspace:^",
    "@repo/server": "workspace:*",
    "@repo/site": "workspace:*",
    "@repo/ssg": "workspace:*",
    "@repo/theme-gallery": "workspace:*",
    "@repo/timeline": "workspace:^",
    "@tanstack/react-router": "1.170.46",
    "effect": "4.0.6",
    "hono": "^4.13.13",
    "playwright-core": "1.56.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@effect/sql-pglite": "4.0.6",
    "@effect/vitest": "4.0.6",
    "@repo/eslint-config-custom": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.19.24",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vanilla-extract/css": "^1.21.3",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^27.0.0",
    "tsconfig": "workspace:*",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  }
}
