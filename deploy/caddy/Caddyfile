# Caddy config for the self-hosted jsonresume.org box.
#
# Cloudflare proxies every hostname, so TLS here uses the Cloudflare origin
# certificate (/etc/caddy/certs, 15-year, *.jsonresume.org) and ufw only lets
# Cloudflare reach 80/443. Install with:
#   sudo cp deploy/caddy/Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy
#
# App ports (see deploy/systemd and /etc/jsonresume/<app>.env): app 3003,
# build-cache 3011.

{
	auto_https off
	servers {
		# Cloudflare ranges, so {remote_host} and X-Forwarded-For carry the
		# visitor's address. Refresh with deploy/scripts/cloudflare-ips.sh.
		import /etc/caddy/cloudflare-trusted-proxies
	}
}

(origin_tls) {
	tls /etc/caddy/certs/jsonresume.org.pem /etc/caddy/certs/jsonresume.org.key
}

# The app on a local port. A deploy restarts it, and it listens again about
# 3s later: retry refused connections for up to 10s instead of answering
# 502. A request that never reached the app is safe to send again; one that
# did is never retried (Caddy would otherwise resend a failed GET).
(upstream) {
	reverse_proxy 127.0.0.1:{args[0]} {
		lb_try_duration 10s
		lb_try_interval 250ms
		lb_retry_match expression false
	}
}

# Request logs, as JSON on stdout (journald keeps 30 days). Secrets that
# can arrive in an address are dropped first: a password from a form sent
# before its page hydrated (or by scanners), reset and confirm tokens,
# OAuth codes.
(access_log) {
	log {
		output stdout
		format filter {
			wrap json
			request>uri query {
				delete password
				delete token
				delete code
			}
		}
	}
}

(app) {
	import origin_tls
	encode zstd gzip
	import upstream {args[0]}
	import access_log
}

# jsonresume.org: the site (apps/app). The docs are a static export on
# GitHub Pages (apps/docs, basePath /docs), served under /docs as before.
jsonresume.org {
	import origin_tls
	encode zstd gzip
	handle /docs {
		rewrite * /jsonresume.org/
		reverse_proxy https://jsonresume.github.io {
			header_up Host jsonresume.github.io
		}
	}
	# handle_path strips /docs before the rewrite (a plain rewrite would run
	# before uri strip_prefix: Caddy orders directives itself).
	handle_path /docs/* {
		rewrite * /jsonresume.org{uri}
		reverse_proxy https://jsonresume.github.io {
			header_up Host jsonresume.github.io
		}
	}
	# Turborepo's remote cache for CI (apps/build-cache): TURBO_API is
	# https://jsonresume.org/_turbo. It checks the token itself.
	handle_path /_turbo/* {
		import upstream 3011
	}
	handle {
		import upstream 3003
	}
	import access_log
}

# The registry is now part of jsonresume.org: the app answers every
# registry URL with a redirect (resumes to /@username, the rest to /registry).
registry.jsonresume.org {
	import app 3003
}

# The design system's docs (apps/styleguide): a static export, released by
# deploy/scripts/deploy.sh styleguide into /srv/www/styleguide.
styleguide.jsonresume.org {
	import origin_tls
	encode zstd gzip
	root * /srv/www/styleguide/current
	# Hashed build files never change; pages are checked on every visit.
	header /_next/static/* Cache-Control "public, max-age=31536000, immutable"
	header ?Cache-Control "public, max-age=0, must-revalidate"
	try_files {path} {path}.html {path}/index.html
	file_server
	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
	import access_log
}

# One name for the site.
www.jsonresume.org, beta.jsonresume.org {
	import origin_tls
	redir https://jsonresume.org{uri} 301
}

# Anything else that reaches the box is not ours to serve.
:443 {
	import origin_tls
	abort
}

:80 {
	redir https://{host}{uri} 308
}
