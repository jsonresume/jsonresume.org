{
  "name": "@repo/resume-editor",
  "version": "0.0.0",
  "private": true,
  "description": "The resume editor: a form generated from the JSON Resume schema, a checked JSON view, and a live preview in any theme",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./validate": "./src/validate.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@effect/atom-react": "4.0.6",
    "@jsonresume/schema": "workspace:*",
    "@jsonresume/theme-metadata": "workspace:*",
    "@jsonresume/ui": "workspace:*",
    "@repo/api": "workspace:*",
    "@repo/api-client": "workspace:*",
    "@repo/content": "workspace:*",
    "@repo/schema-explorer": "workspace:*",
    "@vanilla-extract/css": "^1.21.3",
    "effect": "4.0.6",
    "jsonc-parser": "^3.3.1",
    "@repo/url-state": "workspace:*",
    "@jsonresume/sample-data": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@repo/eslint-config-custom": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.2",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "jsdom": "^27.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsconfig": "workspace:*",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6",
    "@jsonresume/sample-data": "workspace:*"
  }
}
