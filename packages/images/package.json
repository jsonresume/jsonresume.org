{
  "name": "@repo/images",
  "version": "0.0.0",
  "private": true,
  "description": "Other sites' images (avatars, photos) resized and cached by this server: /_img/<width>/<source>.webp",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./url": "./src/url.ts"
  },
  "sideEffects": [
    "**/*.css.ts"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@repo/resume-pdf": "workspace:*",
    "effect": "4.0.6",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@repo/eslint-config-custom": "workspace:*",
    "@types/node": "^20.19.24",
    "tsconfig": "workspace:*",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  }
}
