{
  "name": "jsonresume-theme-jake-technical",
  "version": "0.2.0",
  "description": "A compact technical resume with disciplined alignment, crisp section rules and prominent projects and skills.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dist": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "jsonresume",
    "jsonresume-theme",
    "technical",
    "compact",
    "developer",
    "single-column"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@jsonresume/theme-primitives": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@jsonresume/sample-data": "workspace:*",
    "@jsonresume/theme-kit": "workspace:*",
    "@repo/eslint-config-custom": "workspace:*",
    "@vanilla-extract/css": "^1.21.3",
    "tsconfig": "workspace:*",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsonresume/jsonresume.org.git",
    "directory": "packages/themes/jsonresume-theme-jake-technical"
  },
  "engines": {
    "node": ">=18"
  }
}
