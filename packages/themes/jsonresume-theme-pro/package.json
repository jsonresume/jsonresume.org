{
  "name": "jsonresume-theme-pro",
  "version": "0.2.0",
  "description": "Pro: a typeset, single-column serif résumé theme for JSON Resume",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "fonts/LICENSE.md",
    "DESIGN.md"
  ],
  "scripts": {
    "fonts": "node scripts/embed-fonts.mjs",
    "test": "vitest run",
    "lint": "eslint src test scripts --ext .js,.mjs"
  },
  "keywords": [
    "jsonresume",
    "jsonresume-theme",
    "theme",
    "resume",
    "cv",
    "serif"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsonresume/jsonresume.org.git",
    "directory": "packages/themes/jsonresume-theme-pro"
  },
  "devDependencies": {
    "@jsonresume/sample-data": "workspace:*",
    "@jsonresume/theme-kit": "workspace:*",
    "@repo/eslint-config-custom": "workspace:^",
    "vitest": "^3.2.6"
  },
  "publishConfig": {
    "access": "public"
  }
}
