{
  "name": "@repo/schema-explorer",
  "version": "0.0.1",
  "private": true,
  "description": "Browse a JSON Schema as readable sections and fields, next to an example document",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./model": "./src/model.ts"
  },
  "sideEffects": [
    "**/*.css.ts"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@jsonresume/ui": "workspace:*",
    "effect": "4.0.6"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@jsonresume/schema": "workspace:*",
    "@repo/eslint-config-custom": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vanilla-extract/css": "^1.21.3",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "jsdom": "^27.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsconfig": "workspace:*",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  }
}
