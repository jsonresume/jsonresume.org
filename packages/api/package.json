{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "description": "The jsonresume.org HTTP API contract (Effect HttpApi), shared by server and clients",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./cookies": "./src/cookies.ts"
