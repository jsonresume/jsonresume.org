{
  "name": "@repo/contributors",
  "version": "0.0.0",
  "private": true,
  "description": "Everyone who has contributed to JSON Resume, with every credit: the /contributors page, the list_contributors MCP tool and the weekly collector",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./ui": "./src/ui/index.ts"
  },
  "sideEffects": [
    "**/*.css.ts"
  ],
  "scripts": {
    "collect": "node --experimental-strip-types --no-warnings scripts/collect.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts --ext .ts,.tsx"
  },
  "dependencies": {
    "@jsonresume/ui": "workspace:*",
    "@repo/images": "workspace:*",
    "effect": "4.0.6"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.6",
    "@repo/eslint-config-custom": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.19.24",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vanilla-extract/css": "^1.21.3",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "axe-core": "^4.14.0",
    "jsdom": "^27.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsconfig": "workspace:*",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
