{
  "extends": "tsconfig/base.json",
  "compilerOptions": {
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["node", "vite/client"]
  },
  "include": ["src", "scripts"]
}
