{
  "name": "@jsonresume/theme-primitives",
  "version": "0.2.0",
  "description": "Typed, accessible document primitives for complete JSON Resume themes",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run"
  },
  "dependencies": {
    "@jsonresume/utils": "workspace:*",
    "effect": "4.0.6"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.24",
    "@types/jsdom": "^21.1.7",
    "jsdom": "^27.0.0",
    "@jsonresume/sample-data": "workspace:*",
    "@jsonresume/theme-kit": "workspace:*",
    "@repo/eslint-config-custom": "workspace:*",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vanilla-extract/css": "^1.21.3",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsconfig": "workspace:*",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.6",
    "@jsonresume/core": "workspace:*"
  },
  "engines": {
    "node": ">=18"
  }
}
