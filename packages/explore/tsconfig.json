{
  "extends": "tsconfig/base.json",
  "compilerOptions": {
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src"
  ]
}
